ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

FROM ${UBUNTU_IMAGE} AS base
ARG RUST_TOOLCHAIN=1.95.0
ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        curl \
        expect \
        gawk \
        git \
        gnutls-bin \
        iproute2 \
        libfuse-dev \
        libglib2.0-dev \
        libgmp-dev \
        libgnutls28-dev \
        libjson-glib-dev \
        libseccomp-dev \
        libssl-dev \
        libssl3t64 \
        libtasn1-6-dev \
        libtool \
        patch \
        pkg-config \
        python-is-python3 \
        python3 \
        python3-pycparser \
        socat \
        softhsm2 \
        tss2 \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal \
        --default-toolchain "$RUST_TOOLCHAIN" --component rustfmt,clippy \
    && rm /tmp/rustup-init.sh \
    && chmod -R a+rwX "$RUSTUP_HOME" "$CARGO_HOME"
RUN mkdir -p /cache/target "$CARGO_HOME/registry" "$CARGO_HOME/git"
ENV CARGO_TARGET_DIR=/cache/target
WORKDIR /root

FROM base AS validation
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        docker.io \
        docker-buildx \
        rsync \
    && rm -rf /var/lib/apt/lists/*

FROM base AS swtpm
