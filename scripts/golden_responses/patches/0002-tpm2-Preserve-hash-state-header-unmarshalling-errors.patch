From 043ebbc16d476f49c0ec91bd0dca4aaaf97e251b Mon Sep 17 00:00:00 2001
From: Alexander Gryanko <xpahos@gmail.com>
Date: Sun, 27 Sep 2026 23:43:04 +0300
Subject: [PATCH 2/4] tpm2: Preserve hash state header unmarshalling errors

Only unmarshal the hash payload after its header has been validated.

Signed-off-by: Alexander Gryanko <xpahos@gmail.com>
---
 src/tpm2/NVMarshal.c | 32 +++++++++++++++++---------------
 1 file changed, 17 insertions(+), 15 deletions(-)

diff --git a/src/tpm2/NVMarshal.c b/src/tpm2/NVMarshal.c
index 8da249c0..6f29fb18 100644
--- a/src/tpm2/NVMarshal.c
+++ b/src/tpm2/NVMarshal.c
@@ -2142,29 +2142,31 @@ ANY_HASH_STATE_Unmarshal(ANY_HASH_STATE *data, BYTE **buffer, INT32 *size,
                                  ANY_HASH_STATE_MAGIC);
     }
 
-    switch (hashAlg) {
+    if (rc == TPM_RC_SUCCESS) {
+        switch (hashAlg) {
 #if ALG_SHA1
-    case ALG_SHA1_VALUE:
-        rc = tpmHashStateSHA1_Unmarshal(&data->Sha1, buffer, size);
-        break;
+        case ALG_SHA1_VALUE:
+            rc = tpmHashStateSHA1_Unmarshal(&data->Sha1, buffer, size);
+            break;
 #endif
 #if ALG_SHA256
-    case ALG_SHA256_VALUE:
-        rc = tpmHashStateSHA256_Unmarshal(&data->Sha256, buffer, size);
-        break;
+        case ALG_SHA256_VALUE:
+            rc = tpmHashStateSHA256_Unmarshal(&data->Sha256, buffer, size);
+            break;
 #endif
 #if ALG_SHA384
-    case ALG_SHA384_VALUE:
-        rc = tpmHashStateSHA512_Unmarshal(&data->Sha384, buffer, size,
-                                          ALG_SHA384_VALUE);
-        break;
+        case ALG_SHA384_VALUE:
+            rc = tpmHashStateSHA512_Unmarshal(&data->Sha384, buffer, size,
+                                              ALG_SHA384_VALUE);
+            break;
 #endif
 #if ALG_SHA512
-    case ALG_SHA512_VALUE:
-        rc = tpmHashStateSHA512_Unmarshal(&data->Sha512, buffer, size,
-                                          ALG_SHA512_VALUE);
-        break;
+        case ALG_SHA512_VALUE:
+            rc = tpmHashStateSHA512_Unmarshal(&data->Sha512, buffer, size,
+                                              ALG_SHA512_VALUE);
+            break;
 #endif
+        }
     }
 
     /* version 2 starts having indicator for next versions that we can skip;
