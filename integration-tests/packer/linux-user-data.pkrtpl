#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: false
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: libtpms-linux
    username: packer
    password: ${jsonencode(password_hash)}
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  packages:
    - qemu-guest-agent
    - python3
    - tpm2-tools
    - openssl
  late-commands:
    - 'echo "packer ALL=(ALL) NOPASSWD:ALL" > /target/etc/sudoers.d/packer'
    - chmod 0440 /target/etc/sudoers.d/packer
  shutdown: reboot
